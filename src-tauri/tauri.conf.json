{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WuwaID Mobile",
  "version": "0.3.4",
  "identifier": "com.titotfp.wuwaid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WuwaID Mobile",
        "width": 420,
        "height": 760,
        "minWidth": 320,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 26,
      "versionCode": 7,
      "debugApplicationIdSuffix": ".debug"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
